:root {
    flex-direction: column;
}

.slot {
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    width: 64px;
    height: 64px;
    background-color: rgb(102, 102, 102);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(153, 153, 153);
    border-right-color: rgb(153, 153, 153);
    border-top-color: rgb(153, 153, 153);
    border-bottom-color: rgb(153, 153, 153);
}

.hotbar-slot {
    background-color: rgb(77, 77, 77);
    width: 64px;
    height: 64px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(128, 128, 128);
    border-right-color: rgb(128, 128, 128);
    border-top-color: rgb(128, 128, 128);
    border-bottom-color: rgb(128, 128, 128);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.durability-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    min-height: 12px;
    max-height: 12px;
    align-self: stretch;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.durability-bar .unity-progress-bar__container {
    min-height: 12px;
    max-height: 12px;
}

.armor-slot {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.39);
    --overlay: url("project://database/Assets/Game/Content/Shared/Textures/boots_overlay.png?fileID=2800000&guid=2f543caed13126347b137e43a1170ce0&type=3#boots_overlay");
    background-image: var(--overlay);
}

#helmet .armor-slot {
    --overlay: url("project://database/Assets/Game/Content/Shared/Textures/helmet_overlay.png?fileID=2800000&guid=65493327acc64f84fb1c8842d00ca25a&type=3#helmet_overlay");
}

#chestplate .armor-slot {
    --overlay: url("project://database/Assets/Game/Content/Shared/Textures/chestplate_overlay.png?fileID=2800000&guid=ef16657440a02a14f867fec9a1b4118d&type=3#chestplate_overlay");
}

#leggings .armor-slot {
    --overlay: url("project://database/Assets/Game/Content/Shared/Textures/leggings_overlay.png?fileID=2800000&guid=758c50da8c619ae43bde1fe114a15648&type=3#leggings_overlay");
}

#boots .armor-slot {
    --overlay: url("project://database/Assets/Game/Content/Shared/Textures/boots_overlay.png?fileID=2800000&guid=2f543caed13126347b137e43a1170ce0&type=3#boots_overlay");
}
